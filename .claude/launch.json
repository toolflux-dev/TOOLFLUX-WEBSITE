{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static Site — npx serve (port 3000)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "-p", "3000", "--no-clipboard"],
      "port": 3000
    },
    {
      "name": "Static Site — npx http-server (port 8080)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", ".", "-p", "8080", "-c-1", "--cors"],
      "port": 8080
    }
  ]
}
