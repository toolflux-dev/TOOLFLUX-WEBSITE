{
  "id": "toolflux-flux-ledger",
  "name": "FLUX LEDGER — TOOLFLUX",
  "short_name": "FLUX LEDGER",
  "description": "Drop a bank statement PDF, see the cash picture, separate GST from every customer payment.",
  "start_url": "ledger.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f2f5f7",
  "theme_color": "#012B42",
  "categories": ["finance", "business", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Split GST", "short_name": "GST", "url": "ledger.html#gst" },
    { "name": "Import a statement", "short_name": "Import", "url": "ledger.html#import" }
  ],
  "share_target": {
    "action": "ledger.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        { "name": "file", "accept": ["application/pdf", ".pdf"] }
      ]
    }
  }
}
